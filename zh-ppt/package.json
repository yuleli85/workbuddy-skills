  "engines": { "node": ">=18" },
  "license": "UNLICENSED",
  "dependencies": {
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.0.0",
    "sharp": "^0.33.0 || ^0.34.0 || ^0.35.0"
  }
}
